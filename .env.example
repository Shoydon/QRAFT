# Default browser RPC requests travel through the official Nym Anon-RPC worker.
NEXT_PUBLIC_ANON_RPC_WORKER=nym
NEXT_PUBLIC_BOOTSTRAP_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional same-chain RPC override; genesis and contract pins are still checked.
# NEXT_PUBLIC_READ_RPC_URL=https://rpc2.privacy.ethrex.xyz

# Enable ONLY on a local loopback server. npm dev/start bind to 127.0.0.1.
# Required for public account provisioning, signature caching and proof computation.
# The helper uses direct RPC and a disposable, funded devnet gas carrier.
# QRAFT_LOCAL_PQ_SERVICE=1
# QRAFT_DEPLOYER_KEY_FILE=.local/deployer.json
# CLI diagnostic override only; the helper uses the pinned manifest RPC.
# QRAFT_RPC_URL=https://rpc1.privacy.ethrex.xyz

# Alternative Tor worker requires KPS gateways.
# NEXT_PUBLIC_ANON_RPC_WORKER=tor-js
# NEXT_PUBLIC_ANON_RPC_GATEWAYS=
