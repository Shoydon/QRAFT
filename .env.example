# ── Read path ────────────────────────────────────────────────────────────────
# Every chain read goes through an anon-rpc worker. There is no direct-RPC
# fallback: if this path cannot start, reads stop. The defaults below are
# already applied in src/config/pool.ts, so the app works without this file.

# Which anonymizing network to use: "tor-js" (default) or "passthrough".
# passthrough exercises the sandbox and hash pinning but does NOT anonymize,
# and the interface says so when it is selected.
NEXT_PUBLIC_ANON_RPC_WORKER=tor-js

# tor-js reaches Tor through KPS relays, because browsers cannot open raw TCP.
# Without at least one, the read path reports that it is not configured.
# Run your own for anything real. The anon-rpc project publishes a
# demonstration gateway in its adopters list — limited capacity, and it may
# disappear at any time:
#   https://github.com/ethereum/anon-rpc/blob/main/adopters.json5
NEXT_PUBLIC_ANON_RPC_GATEWAYS=

# Read ONCE and NOT anonymized, only to fetch the pinned worker hash from the
# specifier contract on Ethereum mainnet. Use a provider you already rely on.
NEXT_PUBLIC_BOOTSTRAP_RPC_URL=https://ethereum-rpc.publicnode.com

# Where anonymized reads are sent. This endpoint sees the requests but not the
# browser they came from. Defaults to the EIP-8141 alternative-mempool devnet
# (chain 1337), which is the only chain that supports frame transactions.
#
# Standard eth_* / net_* / web3_* methods go to the root URL below. Frame
# transactions go to the sidecar at https://altmempool.forshtat.com/rpc, which
# nothing submits to yet — see "Not done yet" in the README.
NEXT_PUBLIC_READ_RPC_URL=https://altmempool.forshtat.com
